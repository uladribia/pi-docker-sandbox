#!/bin/bash
# pi-sandboxed: Run the pi coding agent inside a Docker sandbox.
# The agent can only access files in the current directory.

set -e

REPO_DIR="/home/newuser/Repositories/ula/pi-docker-sandbox"
source "$REPO_DIR/config.sh"

# ─── Configuration ────────────────────────────────────────────────────────────

LOG_FILE="$REPO_DIR/pi-sandboxed.log"
MEMORY_LIMIT="4g"
CPU_LIMIT="2"
PIDS_LIMIT="256"

# Sensitive file patterns excluded from the workspace mount.
SENSITIVE_PATTERNS=(
    ".env"
    ".env.*"
    ".git/config"
    ".git/credentials"
    ".npmrc"
    ".pypirc"
    "*.pem"
    "*.key"
    "id_rsa"
    "id_ed25519"
)

# Environment variables forwarded into the container.
FORWARDED_VARS=(
    ANTHROPIC_API_KEY
    OPENAI_API_KEY
    GOOGLE_API_KEY
    BRAVE_API_KEY
    PI_MODEL
    PI_PROVIDER
)

# ─── Functions ────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
Usage: pi-sandboxed [OPTIONS] [PI_ARGS...]

Run the pi coding agent inside a sandboxed Docker container.
The agent can only access files in the current directory.

Options:
    --dry-run       Mount the working directory as read-only
    --shell         Drop into bash instead of running pi
    --no-filter     Skip sensitive file filtering (direct bind mount)
    --new-session   Start a fresh session (discard previous conversation)
    --rebuild       Force rebuild the Docker image
    --help          Show this help message

Session persistence:
    By default, conversation history is preserved across runs when
    pi-sandboxed is launched from the same directory. Sessions are
    stored at ~/.pi/agent/sessions/ and scoped to the project folder.
    Use --new-session to start a fresh conversation.

Environment variables:
    ANTHROPIC_API_KEY   Required for Anthropic models
    OPENAI_API_KEY      Required for OpenAI models
    GOOGLE_API_KEY      Required for Google models
    BRAVE_API_KEY       For Brave search skill
    PI_MODEL            Override default model
    PI_PROVIDER         Override default provider

Examples:
    cd ~/my-project && pi-sandboxed
    pi-sandboxed --dry-run "review this code for bugs"
    pi-sandboxed "fix the failing tests"
    pi-sandboxed --new-session "start over from scratch"
EOF
    exit 0
}

check_docker() {
    if ! command -v docker &> /dev/null; then
        echo "Error: docker is not installed." >&2
        exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
        echo "Error: Cannot connect to the Docker daemon." >&2
        echo "Try: sudo usermod -aG docker \$USER" >&2
        exit 1
    fi
}

build_image() {
    if [ ! -d "$REPO_DIR" ]; then
        echo "Error: Build directory not found at $REPO_DIR" >&2
        exit 1
    fi
    echo "Building image from $REPO_DIR..."
    "$REPO_DIR/build.sh"
}

ensure_image() {
    if [[ -z "$(docker images -q "$IMAGE_NAME" 2>/dev/null)" ]]; then
        echo "Image '$IMAGE_NAME' not found."
        build_image
    fi
}

ensure_network() {
    if ! docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
        echo "Creating sandbox network '$NETWORK_NAME'..."
        docker network create "$NETWORK_NAME" >/dev/null
    fi
}

# Copy workspace to a temp dir, excluding sensitive files.
prepare_filtered_workspace() {
    local tmpdir
    tmpdir=$(mktemp -d "/tmp/pi-sandbox-workspace.XXXXXX")

    local excludes=()
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        excludes+=(--exclude="$pattern")
    done

    if command -v rsync &> /dev/null; then
        rsync -a "${excludes[@]}" "$(pwd)/" "$tmpdir/"
    else
        cp -a "$(pwd)/." "$tmpdir/"
        for pattern in "${SENSITIVE_PATTERNS[@]}"; do
            find "$tmpdir" -name "$pattern" -delete 2>/dev/null || true
        done
    fi

    echo "$tmpdir"
}

# Sync changes from temp workspace back, preserving sensitive originals.
sync_back() {
    local tmpdir="$1"

    local excludes=()
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        excludes+=(--exclude="$pattern")
    done

    if command -v rsync &> /dev/null; then
        rsync -a --delete "${excludes[@]}" "$tmpdir/" "$(pwd)/"
    else
        cp -a "$tmpdir/." "$(pwd)/"
    fi
}

# Collect env vars that are set on the host.
collect_env_args() {
    local -n out=$1
    for var in "${FORWARDED_VARS[@]}"; do
        if [ -n "${!var}" ]; then
            out+=(-e "$var=${!var}")
        fi
    done
}

# Build TTY flags array based on attached terminal.
build_tty_flags() {
    local -n flags=$1
    if [ -t 0 ] && [ -t 1 ]; then
        flags+=(-i -t)
    elif [ -t 1 ]; then
        flags+=(-t)
    fi
}

log_session() {
    local mount_mode="$1"
    local session_dir="$2"
    shift 2
    {
        echo "=== pi-sandboxed session: $(date -Iseconds) ==="
        echo "Directory: $(pwd)"
        echo "Command: $*"
        echo "Mount mode: $mount_mode"
        echo "Session dir: ${session_dir:-none (ephemeral)}"
        echo "---"
    } > "$LOG_FILE"
}

# Convert an absolute path to pi's session directory key format.
# pi encodes /a/b/c as --a-b-c-- (slashes become hyphens, wrapped in --).
encode_session_path() {
    local abs_path="$1"
    echo "--${abs_path#/}--" | tr '/' '-'
}

# Return the host-side session directory for the given project path.
resolve_session_dir() {
    local project_dir="$1"
    local encoded
    encoded=$(encode_session_path "$project_dir")
    echo "${HOME}/.pi/agent/sessions/${encoded}"
}

# Create the session directory if it does not exist yet.
ensure_session_dir() {
    local session_dir="$1"
    mkdir -p "$session_dir"
}

# ─── Parse arguments ─────────────────────────────────────────────────────────

DRY_RUN=false
SHELL_MODE=false
FILTER_SENSITIVE=true
NEW_SESSION=false
FORCE_REBUILD=false
PI_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)       DRY_RUN=true;          shift ;;
        --shell)         SHELL_MODE=true;        shift ;;
        --no-filter)     FILTER_SENSITIVE=false; shift ;;
        --new-session)   NEW_SESSION=true;       shift ;;
        --rebuild)       FORCE_REBUILD=true;     shift ;;
        --help)          usage ;;
        *)               PI_ARGS+=("$1");        shift ;;
    esac
done

# ─── Main ─────────────────────────────────────────────────────────────────────

check_docker

if [ "$FORCE_REBUILD" = true ]; then
    build_image
else
    ensure_image
fi

ensure_network

# Collect environment variables
ENV_ARGS=()
collect_env_args ENV_ARGS

if [ ${#ENV_ARGS[@]} -eq 0 ]; then
    echo "⚠  Warning: No API keys found. Set ANTHROPIC_API_KEY (or similar) before running."
fi

# Set up workspace mount
CLEANUP_DIR=""
MOUNT_MODE="direct"

if [ "$DRY_RUN" = true ]; then
    MOUNT_MODE="read-only"
    MOUNT_ARGS=(-v "$(pwd):/workspace:ro")
    echo "🔒 Dry-run mode: workspace mounted read-only"
elif [ "$FILTER_SENSITIVE" = true ]; then
    MOUNT_MODE="filtered"
    CLEANUP_DIR=$(prepare_filtered_workspace)
    MOUNT_ARGS=(-v "$CLEANUP_DIR:/workspace")
    echo "🔒 Filtering sensitive files from workspace..."
    echo "   Excluded: ${SENSITIVE_PATTERNS[*]}"
else
    MOUNT_ARGS=(-v "$(pwd):/workspace")
fi

# Set up session persistence: mount the host project's session dir to the
# container's /workspace session dir so conversation history survives restarts.
# pi names session dirs by encoding the working path (e.g. --workspace--).
SESSION_MOUNT_ARGS=()
HOST_SESSION_DIR=""
if [ "$NEW_SESSION" = false ] && [ "$SHELL_MODE" = false ]; then
    HOST_SESSION_DIR=$(resolve_session_dir "$(pwd)")
    ensure_session_dir "$HOST_SESSION_DIR"
    # /workspace is the container's pwd; pi encodes it as --workspace--
    SESSION_MOUNT_ARGS=(-v "${HOST_SESSION_DIR}:/home/node/.pi/agent/sessions/--workspace--")
fi

# Set up container command
if [ "$SHELL_MODE" = true ]; then
    CONTAINER_CMD=("bash" "${PI_ARGS[@]}")
else
    CONTAINER_CMD=("pi" "${PI_ARGS[@]}")
fi

echo ""
echo "🐳 Starting sandboxed pi agent"
echo "   Directory: $(pwd)"
echo "   Network:   $NETWORK_NAME"
echo "   Resources: mem=$MEMORY_LIMIT, cpus=$CPU_LIMIT, pids=$PIDS_LIMIT"
if [ -n "$HOST_SESSION_DIR" ]; then
    echo "   Session:   $HOST_SESSION_DIR"
else
    echo "   Session:   ephemeral (--new-session)"
fi
echo ""

log_session "$MOUNT_MODE" "$HOST_SESSION_DIR" "${CONTAINER_CMD[*]}"

# Run container
TTY_FLAGS=()
build_tty_flags TTY_FLAGS

docker run --rm "${TTY_FLAGS[@]}" \
    "${MOUNT_ARGS[@]}" \
    "${SESSION_MOUNT_ARGS[@]}" \
    "${ENV_ARGS[@]}" \
    --user "$(id -u):$(id -g)" \
    --network="$NETWORK_NAME" \
    --memory="$MEMORY_LIMIT" \
    --cpus="$CPU_LIMIT" \
    --pids-limit="$PIDS_LIMIT" \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    -v "${HOME}/.pi:/home/node/.pi-host:ro" \
    -e HOME=/home/node \
    --name "pi-sandbox-$(date +%s)" \
    "$IMAGE_NAME" \
    "${CONTAINER_CMD[@]}" > >(tee -a "$LOG_FILE") 2> >(tee -a "$LOG_FILE" >&2)

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ pi-sandboxed exited with code $EXIT_CODE. See log: $LOG_FILE" >&2
fi

# Sync back if we used a filtered workspace
if [ -n "$CLEANUP_DIR" ]; then
    echo ""
    echo "🔄 Syncing changes back to $(pwd)..."
    sync_back "$CLEANUP_DIR"
    rm -rf "$CLEANUP_DIR"
    echo "✅ Done."
fi

exit $EXIT_CODE
