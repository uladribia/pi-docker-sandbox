#!/bin/bash

# pi-sandboxed: Run the pi coding agent inside a Docker sandbox.
# The agent can only access files in the current directory.

set -e

# --- Configuration ---
IMAGE_NAME="pi-agent-sandbox"
REPO_DIR="/home/newuser/Repositories/ula/pi-docker-sandbox"
LOG_FILE="$REPO_DIR/pi-sandboxed.log"
MEMORY_LIMIT="4g"
CPU_LIMIT="2"
PIDS_LIMIT="256"

# Allowed domains for outbound network access.
# Add more as needed (e.g., npm registry, pypi, github).
ALLOWED_DOMAINS=(
    api.anthropic.com
    api.openai.com
    generativelanguage.googleapis.com
    api.search.brave.com
    registry.npmjs.org
    pypi.org
    files.pythonhosted.org
    github.com
    objects.githubusercontent.com
)

# Sensitive file/directory patterns to exclude from the mount.
SENSITIVE_PATTERNS=(
    ".env"
    ".env.*"
    ".git/config"
    ".git/credentials"
    ".npmrc"
    ".pypirc"
    "*.pem"
    "*.key"
    "id_rsa"
    "id_ed25519"
)

# --- Functions ---
usage() {
    cat <<EOF
Usage: pi-sandboxed [OPTIONS] [PI_ARGS...]

Run the pi coding agent inside a sandboxed Docker container.
The agent can only access files in the current directory.

Options:
    --dry-run       Mount the working directory as read-only (for code review)
    --shell         Drop into a bash shell instead of running pi
    --no-filter     Don't filter sensitive files (use direct bind mount)
    --rebuild       Force rebuild the Docker image
    --help          Show this help message

Environment variables:
    ANTHROPIC_API_KEY   Required for Anthropic models
    OPENAI_API_KEY      Required for OpenAI models
    GOOGLE_API_KEY      Required for Google models
    BRAVE_API_KEY       For Brave search skill
    PI_MODEL            Override default model
    PI_PROVIDER         Override default provider

Examples:
    cd ~/my-project && pi-sandboxed
    pi-sandboxed --dry-run "review this code for bugs"
    pi-sandboxed "fix the failing tests"
EOF
    exit 0
}

check_prerequisites() {
    if ! command -v docker &> /dev/null; then
        echo "Error: docker is not installed. Please install docker first."
        exit 1
    fi

    if ! docker info >/dev/null 2>&1; then
        echo "Error: Cannot connect to the Docker daemon."
        echo "Is the docker daemon running? Do you have permission? (Try: sudo usermod -aG docker \$USER)"
        exit 1
    fi
}

build_image() {
    if [ -d "$REPO_DIR" ]; then
        echo "Building image from $REPO_DIR..."
        (cd "$REPO_DIR" && ./build.sh)
    else
        echo "Error: Cannot find build directory at $REPO_DIR"
        echo "Please build manually: docker build -t $IMAGE_NAME <path-to-Dockerfile>"
        exit 1
    fi
}

ensure_image() {
    if [[ "$(docker images -q $IMAGE_NAME 2>/dev/null)" == "" ]]; then
        echo "Image '$IMAGE_NAME' not found."
        build_image
    fi
}

setup_network() {
    local net_name="pi-sandbox-net"

    # Create the network if it doesn't exist
    if ! docker network inspect "$net_name" >/dev/null 2>&1; then
        echo "Creating sandbox network '$net_name'..."
        docker network create "$net_name" >/dev/null
    fi

    echo "$net_name"
}

prepare_filtered_workspace() {
    # Copy the workspace to a temp dir, excluding sensitive files.
    # Returns the path to the temp dir.
    local tmpdir
    tmpdir=$(mktemp -d "/tmp/pi-sandbox-workspace.XXXXXX")

    # Build rsync exclude args
    local excludes=()
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        excludes+=(--exclude="$pattern")
    done

    # Use rsync if available, otherwise cp with manual exclusion
    if command -v rsync &> /dev/null; then
        rsync -a "${excludes[@]}" "$(pwd)/" "$tmpdir/"
    else
        # Fallback: plain copy then remove sensitive files
        cp -a "$(pwd)/." "$tmpdir/"
        for pattern in "${SENSITIVE_PATTERNS[@]}"; do
            find "$tmpdir" -name "$pattern" -delete 2>/dev/null || true
        done
    fi

    echo "$tmpdir"
}

sync_back() {
    # Sync changes from the filtered workspace back to the real workspace.
    # Excludes sensitive files so we don't delete originals.
    local tmpdir="$1"

    if command -v rsync &> /dev/null; then
        local excludes=()
        for pattern in "${SENSITIVE_PATTERNS[@]}"; do
            excludes+=(--exclude="$pattern")
        done
        rsync -a --delete "${excludes[@]}" "$tmpdir/" "$(pwd)/"
    else
        # Fallback: copy back everything (sensitive files were already removed from tmpdir)
        cp -a "$tmpdir/." "$(pwd)/"
    fi
}

# --- Parse arguments ---
DRY_RUN=false
SHELL_MODE=false
FILTER_SENSITIVE=true
FORCE_REBUILD=false
PI_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --shell)
            SHELL_MODE=true
            shift
            ;;
        --no-filter)
            FILTER_SENSITIVE=false
            shift
            ;;
        --rebuild)
            FORCE_REBUILD=true
            shift
            ;;
        --help)
            usage
            ;;
        *)
            PI_ARGS+=("$1")
            shift
            ;;
    esac
done

# --- Main ---
check_prerequisites

if [ "$FORCE_REBUILD" = true ]; then
    build_image
else
    ensure_image
fi

# Collect API keys
ENV_ARGS=()
for var in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY BRAVE_API_KEY PI_MODEL PI_PROVIDER; do
    if [ -n "${!var}" ]; then
        ENV_ARGS+=(-e "$var=${!var}")
    fi
done

if [ ${#ENV_ARGS[@]} -eq 0 ]; then
    echo "⚠  Warning: No API keys found in environment. Set ANTHROPIC_API_KEY (or similar) before running."
fi

# Setup network
NETWORK=$(setup_network)

# Determine mount mode and workspace path
MOUNT_OPTS=""
WORKSPACE_DIR=""
CLEANUP_DIR=""

if [ "$DRY_RUN" = true ]; then
    echo "🔒 Dry-run mode: workspace mounted read-only"
    WORKSPACE_DIR="$(pwd)"
    MOUNT_OPTS="-v $(pwd):/workspace:ro"
elif [ "$FILTER_SENSITIVE" = true ]; then
    echo "🔒 Filtering sensitive files from workspace..."
    WORKSPACE_DIR=$(prepare_filtered_workspace)
    CLEANUP_DIR="$WORKSPACE_DIR"
    MOUNT_OPTS="-v $WORKSPACE_DIR:/workspace"
    echo "   Excluded patterns: ${SENSITIVE_PATTERNS[*]}"
else
    WORKSPACE_DIR="$(pwd)"
    MOUNT_OPTS="-v $(pwd):/workspace"
fi

# Determine command
if [ "$SHELL_MODE" = true ]; then
    CONTAINER_CMD=("bash" "${PI_ARGS[@]}")
else
    CONTAINER_CMD=("pi" "${PI_ARGS[@]}")
fi

echo ""
echo "🐳 Starting sandboxed pi agent"
echo "   Directory: $(pwd)"
echo "   Network:   $NETWORK (egress filtered)"
echo "   Resources: mem=$MEMORY_LIMIT, cpus=$CPU_LIMIT, pids=$PIDS_LIMIT"
echo ""

# Run the container
CONTAINER_NAME="pi-sandbox-$(date +%s)"

# Ensure persistent pi config directory exists
mkdir -p "${HOME}/.pi-sandbox"

# Use -it only if we have a TTY
TTY_FLAG=""
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAG="-it"
elif [ -t 1 ]; then
    TTY_FLAG="-t"
fi

# Log session metadata
{
    echo "=== pi-sandboxed session: $(date -Iseconds) ==="
    echo "Directory: $(pwd)"
    echo "Command: ${CONTAINER_CMD[*]}"
    echo "Container: $CONTAINER_NAME"
    echo "Mount mode: $([ "$DRY_RUN" = true ] && echo "read-only" || ([ "$FILTER_SENSITIVE" = true ] && echo "filtered" || echo "direct"))"
    echo "---"
} > "$LOG_FILE"

docker run --rm $TTY_FLAG \
    $MOUNT_OPTS \
    "${ENV_ARGS[@]}" \
    --user "$(id -u):$(id -g)" \
    --network="$NETWORK" \
    --memory="$MEMORY_LIMIT" \
    --cpus="$CPU_LIMIT" \
    --pids-limit="$PIDS_LIMIT" \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    -v "${HOME}/.pi:/home/node/.pi-host:ro" \
    -e HOME=/home/node \
    --name "$CONTAINER_NAME" \
    "$IMAGE_NAME" \
    "${CONTAINER_CMD[@]}" > >(tee -a "$LOG_FILE") 2> >(tee -a "$LOG_FILE" >&2)

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ pi-sandboxed exited with code $EXIT_CODE. See log: $LOG_FILE" >&2
fi

# Sync back changes if we used a filtered workspace
if [ -n "$CLEANUP_DIR" ]; then
    echo ""
    echo "🔄 Syncing changes back to $(pwd)..."
    sync_back "$CLEANUP_DIR"
    rm -rf "$CLEANUP_DIR"
    echo "✅ Done."
fi

exit $EXIT_CODE
